# Ghaira API Environment Configuration
# Copy this file to .env and fill in your values

# Flask configuration
SECRET_KEY=change-this-to-a-random-32-byte-hex-string

# Database - Neon direct connection URL (for schema init, local testing)
# Format: postgresql://username:password@hostname/database?sslmode=require
DATABASE_URL=

# Cloud Run configuration
# Set these when deploying to Google Cloud Run
ALLOW_REGISTRATION=0  # 0=disabled, 1=enabled (testing only)
COOKIE_SECURE=1  # 0=local HTTP, 1=production HTTPS

# Firebase configuration
FRONTEND_ORIGIN=https://exercice7.web.app