+
+/*
+ * beta.mr visual contract
+ *
+ * The legacy application used Bootstrap 4.3.1 on the public/auth screens and
+ * SB Admin 2 (Bootstrap 4.3.1 + Nunito) in authenticated screens.  Keep the
+ * replacement's components and behaviour, but make their typography, controls
+ * and spacing obey those same measurements everywhere.
+ */
+:root {
+    --legacy-blue: #4e73df;
+    --legacy-cyan: #36b9cc;
+    --legacy-green: #1cc88a;
+    --legacy-red: #e74a3b;
+    --legacy-yellow: #f6c23e;
+    --legacy-gray: #858796;
+    --legacy-border: #d1d3e2;
+    --legacy-radius: 0.35rem;
+    --legacy-control-height: calc(1.5em + 0.75rem + 2px);
+}
+
+.beta-public,
+.legacy-auth-shell {
+    font-family: Arial, Helvetica, sans-serif;
+    font-size: 12px;
+    font-weight: 400;
+    line-height: 1.2;
+    letter-spacing: normal;
+}
+
+.staff-shell {
+    font-family: Nunito, -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto,
+        "Helvetica Neue", Arial, sans-serif;
+    font-size: 1rem;
+    font-weight: 400;
+    line-height: 1.5;
+    letter-spacing: normal;
+    color: #858796;
+}
+
+.beta-public button,
+.beta-public input,
+.beta-public optgroup,
+.beta-public select,
+.beta-public textarea,
+.legacy-auth-shell button,
+.legacy-auth-shell input,
+.legacy-auth-shell optgroup,
+.legacy-auth-shell select,
+.legacy-auth-shell textarea,
+.staff-shell button,
+.staff-shell input,
+.staff-shell optgroup,
+.staff-shell select,
+.staff-shell textarea {
+    font: inherit;
+    letter-spacing: inherit;
+}
+
+/* Exact Bootstrap/SB Admin control geometry. */
+.beta-public [data-slot='button'],
+.legacy-auth-shell [data-slot='button'],
+.staff-shell [data-slot='button'] {
+    min-height: var(--legacy-control-height);
+    border: 1px solid transparent;
+    border-radius: var(--legacy-radius);
+    padding: 0.375rem 0.75rem;
+    font-size: 1rem;
+    font-weight: 400;
+    line-height: 1.5;
+    box-shadow: none;
+    transition:
+        color 0.15s ease-in-out,
+        background-color 0.15s ease-in-out,
+        border-color 0.15s ease-in-out,
+        box-shadow 0.15s ease-in-out;
+}
+
+.beta-public [data-slot='button'][data-size='sm'],
+.legacy-auth-shell [data-slot='button'][data-size='sm'],
+.staff-shell [data-slot='button'][data-size='sm'] {
+    min-height: calc(1.5em + 0.5rem + 2px);
+    padding: 0.25rem 0.5rem;
+    font-size: 0.875rem;
+    line-height: 1.5;
+}
+
+.beta-public [data-slot='button'][data-size='lg'],
+.legacy-auth-shell [data-slot='button'][data-size='lg'],
+.staff-shell [data-slot='button'][data-size='lg'] {
+    min-height: calc(1.5em + 1rem + 2px);
+    padding: 0.5rem 1rem;
+    font-size: 1.25rem;
+    line-height: 1.5;
+}
+
+.beta-public [data-slot='button'][data-size^='icon'],
+.legacy-auth-shell [data-slot='button'][data-size^='icon'],
+.staff-shell [data-slot='button'][data-size^='icon'] {
+    padding: 0.375rem;
+}
+
+.beta-public [data-slot='button'][data-variant='default'],
+.legacy-auth-shell [data-slot='button'][data-variant='default'],
+.staff-shell [data-slot='button'][data-variant='default'] {
+    border-color: var(--legacy-blue);
+    background: var(--legacy-blue);
+    color: #fff;
+}
+
+.beta-public [data-slot='button'][data-variant='default']:hover,
+.legacy-auth-shell [data-slot='button'][data-variant='default']:hover,
+.staff-shell [data-slot='button'][data-variant='default']:hover {
+    border-color: #2653d4;
+    background: #2e59d9;
+    color: #fff;
+}
+
+.beta-public [data-slot='button'][data-variant='destructive'],
+.legacy-auth-shell [data-slot='button'][data-variant='destructive'],
+.staff-shell [data-slot='button'][data-variant='destructive'] {
+    border-color: var(--legacy-red);
+    background: var(--legacy-red);
+    color: #fff;
+}
+
+.beta-public [data-slot='button'][data-variant='outline'],
+.legacy-auth-shell [data-slot='button'][data-variant='outline'],
+.staff-shell [data-slot='button'][data-variant='outline'] {
+    border-color: var(--legacy-border);
+    background: #fff;
+    color: #6e707e;
+}
+
+.beta-public [data-slot='button'][data-variant='outline']:hover,
+.legacy-auth-shell [data-slot='button'][data-variant='outline']:hover,
+.staff-shell [data-slot='button'][data-variant='outline']:hover {
+    border-color: #c4c6cc;
+    background: #eaecf4;
+    color: #3a3b45;
+}
+
+.beta-public [data-slot='button']:focus-visible,
+.legacy-auth-shell [data-slot='button']:focus-visible,
+.staff-shell [data-slot='button']:focus-visible {
+    outline: 0;
+    box-shadow: 0 0 0 0.2rem rgba(78, 115, 223, 0.25);
+}
+
+.beta-public input:not([type='checkbox']):not([type='radio']),
+.beta-public select,
+.beta-public textarea,
+.legacy-auth-shell input:not([type='checkbox']):not([type='radio']),
+.legacy-auth-shell select,
+.legacy-auth-shell textarea,
+.staff-shell input:not([type='checkbox']):not([type='radio']),
+.staff-shell select,
+.staff-shell textarea {
+    min-height: var(--legacy-control-height);
+    border: 1px solid var(--legacy-border);
+    border-radius: var(--legacy-radius);
+    background: #fff;
+    padding: 0.375rem 0.75rem;
+    color: #6e707e;
+    font-size: 1rem;
+    line-height: 1.5;
+}
+
+.beta-public input:focus,
+.beta-public select:focus,
+.beta-public textarea:focus,
+.legacy-auth-shell input:focus,
+.legacy-auth-shell select:focus,
+.legacy-auth-shell textarea:focus,
+.staff-shell input:focus,
+.staff-shell select:focus,
+.staff-shell textarea:focus {
+    border-color: #bac8f3;
+    outline: 0;
+    box-shadow: 0 0 0 0.2rem rgba(78, 115, 223, 0.25);
+}
+
+.staff-shell h1,
+.staff-shell h2,
+.staff-shell h3,
+.staff-shell h4,
+.staff-shell h5,
+.staff-shell h6 {
+    margin-top: 0;
+    margin-bottom: 0.5rem;
+    color: #5a5c69;
+    font-weight: 400;
+    line-height: 1.2;
+}
+
+.staff-shell h1 { font-size: 2.5rem; }
+.staff-shell h2 { font-size: 2rem; }
+.staff-shell h3 { font-size: 1.75rem; }
+.staff-shell h4 { font-size: 1.5rem; }
+.staff-shell h5 { font-size: 1.25rem; }
+.staff-shell h6 { font-size: 1rem; }
+
+.staff-page-stage {
+    background: #f8f9fc !important;
+}
+
+.staff-page-stage [data-slot='card'] {
+    margin-bottom: 1.5rem;
+    border: 1px solid #e3e6f0;
+    border-radius: var(--legacy-radius);
+    box-shadow: 0 0.15rem 1.75rem 0 rgba(58, 59, 69, 0.15);
+}
+
+.staff-page-stage [data-slot='card-header'] {
+    min-height: 3.25rem;
+    padding: 0.75rem 1.25rem;
+}
+
+.staff-page-stage [data-slot='card-content'] {
+    padding: 1.25rem;
+}
+
+.staff-page-stage table th,
+.staff-page-stage table td {
+    padding: 0.75rem;
+    border-top: 1px solid #e3e6f0;
+    line-height: 1.5;
+}
+
+/* The public portal deliberately retains beta.mr's compact 12px controls. */
+.beta-public [data-slot='button'] {
+    min-height: 30px;
+    padding: 0.25rem 0.5rem;
+    border-radius: 0.2rem;
+    font-size: 12px;
+    line-height: 1.5;
+}
+
+@media (prefers-reduced-motion: reduce) {
+    .beta-public [data-slot='button'],
+    .legacy-auth-shell [data-slot='button'],
+    .staff-shell [data-slot='button'] {
+        transition: none;
+    }
+}
